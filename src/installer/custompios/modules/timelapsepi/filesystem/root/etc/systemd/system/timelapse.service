[Unit]
Description=Timelapse camera
After=network.target time-sync.target
# Never stop restarting, see Restart= below.
StartLimitIntervalSec=0

[Service]
User=pi
Group=pi
# timelapse-settings.json and timelapse.log are created here. The binary in
# /opt/timelapse is part of the image (see docs/installer.md).
WorkingDirectory=/home/pi
ExecStart=/opt/timelapse/timelapse -port=:8080 -logToFile=true -secondsBetweenCaptures=1800 -storageFolder=/home/pi/timelapse-pictures/
# Come back after crashes and failed starts, forever.
Restart=always
RestartSec=5
# SIGTERM lets the app finish its HTTP responses and abort a running capture
# cleanly before systemd kills it.
TimeoutStopSec=20
# The app pings systemd (WATCHDOG=1) every minute while its capture loop is
# alive; when it hangs or stops taking photos, systemd restarts it. The
# binary must be built from the same commit as this file (src/backend/watchdog.go).
WatchdogSec=2min
NotifyAccess=main
# Lets the web UI set the clock (POST /admin/time): a Pi without a clock
# module and without network time loses time at every power cut.
AmbientCapabilities=CAP_SYS_TIME

[Install]
WantedBy=multi-user.target
