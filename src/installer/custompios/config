export DIST_NAME=timelapsepi
# make image passes the output of git describe.
export DIST_VERSION=${DIST_VERSION:-dev}

# Base image: Raspberry Pi OS Lite 32-bit (armhf, runs on the Pi Zero W),
# pinned by URL and SHA-256. build-image.sh downloads and verifies it.
export BASE_BOARD=raspberrypiarmhf
TIMELAPSEPI_BASE_IMAGE_URL=https://downloads.raspberrypi.com/raspios_lite_armhf/images/raspios_lite_armhf-2026-10-06/2026-10-06-raspios-trixie-armhf-lite.img.xz
TIMELAPSEPI_BASE_IMAGE_SHA256=2c302771f34c67a0b7ae7aa2e0dcdd3eac660504be59193c011ba79d412e1632
export BASE_ZIP_IMG=${DIST_PATH}/image/${TIMELAPSEPI_BASE_IMAGE_URL##*/}

# Image name: <base image date>-timelapsepi-trixie-armhf-lite-<version>.zip
export BASE_IGNORE_VARIANT_NAME=yes

# No apt cache across builds: CustomPiOS skips "apt update" when the cache is
# less than an hour old, so a quick rebuild would install from stale lists.
export BASE_APT_CACHE=no

export BASE_ENABLE_UART=yes
export BASE_SSH_ENABLE=yes

export NETWORK_DISABLE_PWRSAVE=yes
export NETWORK_WPA_SUPPLICANT=no
export NETWORK_NETWORK_MANAGER=yes

# No raspicam module: it configures the legacy camera stack (start_x=1,
# camera_auto_detect=0, gpu_mem=128), which hides the camera from libcamera and
# rpicam-still. timelapsepi installs rpicam-apps-lite and keeps auto-detection.
export MODULES="base(network,disable-services(timelapsepi))"
