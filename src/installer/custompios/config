export DIST_NAME=timelapsepi
export DIST_VERSION=0.5.0

export BASE_ENABLE_UART=yes
export BASE_SSH_ENABLE=yes

export NETWORK_DISABLE_PWRSAVE=yes
export NETWORK_WPA_SUPPLICANT=no
export NETWORK_NETWORK_MANAGER=yes

# No raspicam module: it configures the legacy camera stack (start_x=1,
# camera_auto_detect=0, gpu_mem=128), which hides the camera from libcamera and
# rpicam-still. timelapsepi installs rpicam-apps-lite and keeps auto-detection.
export MODULES="base(network,disable-services(timelapsepi))"
